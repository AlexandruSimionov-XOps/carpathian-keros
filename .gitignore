# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local config (AGENTS.md V.3)
.env
.env.*

# OpenTofu: providers cache, local state and account-specific values (examples are committed as *.example)
# The provider lock files (.terraform.lock.hcl) ARE committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
backend.hcl
crash.log

# Windows metadata added when files are copied into WSL (e.g. "logo.jpg:Zone.Identifier")
*:Zone.Identifier

# Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local runtime output
*.log
*.pdf
